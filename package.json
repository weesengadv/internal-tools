{
  "name": "weeseng-production-tool",
  "version": "1.1.0",
  "private": true,
  "description": "Weeseng Software production tools for G-code, STL checking, and signage quotation.",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node tests/runtime-config.test.cjs && node tests/pricing-sync.test.cjs && node tests/pricing-api.test.cjs && node tests/static-paths.test.cjs && node tests/desktop-window.test.cjs && node tests/release-consistency.test.cjs && node tests/signage-pricing-sync-ui.test.mjs && node tests/signage-dialog-position.test.mjs && node tests/signage-measurement-layout.test.mjs && node tests/signage-export-mode.test.mjs && node tests/signage-job-handoff.test.mjs && node tests/signage-zip-store.test.mjs && node tests/character-cropper.test.mjs",
    "build:desktop": "electron-builder --win portable",
    "package:office": "node scripts/package-office.cjs",
    "package:office-host": "node scripts/package-office-host.cjs",
    "test:office-host": "node --test tests/office-host.test.cjs",
    "test:word-tools": "node --test tests/word-tools-service.test.cjs tests/word-tools-panel.test.mjs tests/word-tools-api.test.cjs"
  },
  "build": {
    "appId": "com.weeseng.productiontool",
    "productName": "Weeseng Production Tool",
    "asar": true,
    "asarUnpack": ["src/tube-frame/freecad_worker.py"],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.cjs",
      "server.js",
      "app.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "SIGNAGE_QUOTATION_MANUAL.html",
      "signage-config.example.json",
      "signage-pricing-sample.csv",
      "package.json",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "tools/word-tools",
        "to": "word-tools",
        "filter": ["backend/**/*.py", "backend/*.json", "backend/requirements.txt", "dist/client/**/*", "README.md"]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Weeseng Production Tool.exe"
    }
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^5.1.1",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
